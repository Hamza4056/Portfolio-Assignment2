<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<!-- Main content of the About Me page -->
<main class="container pb-5 mb-5">
    <div class="row">
        <div class="offset-md-1 col-md-10">

            <h1><%= title %></h1>

            <!-- Displays my name, picture and biography -->
            <h2><%= name %></h2>
            <img src="<%= picture %>" alt="<%= name %>" width="250">

            <p><%= biography %></p>

            <!-- Displays my introduction video -->
            <h2>Introduction Video</h2>

            <video width="320" height="240" controls poster="<%= picture %>">
                <source src="<%= video %>" type="video/mp4">
            </video>

        </div>
    </div>
</main>

<%- include partials/footer.ejs %>